load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# masstree-beta @ 11198427, vendored under third_party/masstree. Its config.h is
# generated by bootstrap.sh + ./configure (the same steps its own CMake build
# runs) and checked in, so the Bazel build needs no autoconf. The source list is
# the support library; the tree itself is header-only templates.
cc_library(
    name = "masstree",
    srcs = [
        "masstree/compiler.cc",
        "masstree/json.cc",
        "masstree/kvrandom.cc",
        "masstree/kvthread.cc",
        "masstree/memdebug.cc",
        "masstree/msgpack.cc",
        "masstree/str.cc",
        "masstree/straccum.cc",
        "masstree/string.cc",
    ],
    hdrs = glob(["masstree/*.hh", "masstree/*.h"]),
    copts = ["-include", "third_party/masstree/config.h"],
    includes = ["masstree"],
    visibility = ["//visibility:public"],
    deps = [":clp"],
)

# clp.c is C: upstream compiles it without config.h, which is C++-only.
cc_library(
    name = "clp",
    srcs = ["masstree/clp.c"],
    hdrs = ["masstree/clp.h"],
    includes = ["masstree"],
)

# The wrapper includes its headers as "masstree/...", which resolves against the
# including file, so it must sit next to the masstree/ directory.
cc_library(
    name = "masstree_wrapper",
    hdrs = ["masstree_wrapper.hpp"],
    deps = [":masstree"],
    visibility = ["//visibility:public"],
)

# The mrcu/epoch globals masstree declares as extern. alwayslink: the tree's
# own objects reference them too, and which archive the linker scans first
# mustn't matter.
cc_library(
    name = "masstree_globals",
    srcs = ["masstree_globals.cpp"],
    alwayslink = True,
    deps = [":masstree_wrapper"],
    visibility = ["//visibility:public"],
)
